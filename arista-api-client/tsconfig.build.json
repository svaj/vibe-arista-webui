{
  "compilerOptions": {
    /* Deliberately inside outDir (the composite default): deleting dist must also delete the
       build info, otherwise `tsc -b` believes the declarations are current, skips emitting,
       and dependent projects fail with TS6305/TS2307. */
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "composite": true,
    "target": "es2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Library build: types only — Vite/Rolldown emits the JS (see vite.config.ts). */
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    /* Strictness (PLAN.md M0) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* #61 (DR-021): src/testing/** is part of the type build now — two entries of the exports map
     point at it, so its declarations must emit. Test files stay out of the shipped graph the same
     way as before; the browser-safety of `./testing` is enforced by the guard + its test, and the
     Node-only half is reachable solely from src/node-testing.ts. */
  "exclude": ["src/**/*.test.ts", "src/**/*.live.test.ts"]
}
