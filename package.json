{
  "name": "vibe-arista-webui",
  "private": true,
  "version": "0.0.0",
  "description": "npm workspaces root for the Arista EOS eAPI toolchain: @devhax-heavy-industries/arista-eapi + arista-webui",
  "workspaces": [
    "arista-api-client",
    "arista-webui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs:check": "npm run docs:check -w @devhax-heavy-industries/arista-eapi",
    "lint:scripts": "oxlint --config .oxlintrc.json scripts",
    "smoke:dist": "node scripts/dist-smoke.mjs",
    "lab:up": "node scripts/ceos-lab.mjs up",
    "lab:probe": "node scripts/ceos-lab.mjs probe",
    "lab:down": "node scripts/ceos-lab.mjs down",
    "lab:list": "node scripts/ceos-lab.mjs list",
    "lab:mgmt-bands": "node scripts/ceos-lab.mjs mgmt-bands",
    "lab:run": "node scripts/ceos-lab.mjs run",
    "fixtures:refresh": "node scripts/ceos-lab.mjs fixtures",
    "e2e": "npm run e2e -w arista-webui"
  }
}
