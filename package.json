{
  "name": "vibe-arista-webui",
  "private": true,
  "version": "0.0.0",
  "description": "npm workspaces root for the Arista EOS eAPI toolchain: @devhax-heavy-industries/arista-eapi + arista-webui",
  "workspaces": [
    "arista-api-client",
    "arista-webui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
